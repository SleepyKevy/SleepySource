diff --git a/.github/workflows/publish-v1.0.0.yml b/.github/workflows/publish-v1.0.0.yml
index bc4e29c..1454f46 100644
--- a/.github/workflows/publish-v1.0.0.yml
+++ b/.github/workflows/publish-v1.0.0.yml
@@ -63,7 +63,7 @@ jobs:
         run: |
           $ErrorActionPreference = 'Stop'
           $release = Join-Path $PWD 'release-dist'
-          $public = Join-Path $release 'public'
+          $public = Join-Path $release 'SleepySource 1.0.0'
           $source = Join-Path $release 'SleepySource 1.0.0 Source'
           if (Test-Path $release) { Remove-Item $release -Recurse -Force }
           New-Item -ItemType Directory -Path $public -Force | Out-Null
@@ -75,8 +75,8 @@ jobs:
           Copy-Item 'readme.txt' $public -Force
           Copy-Item 'release_notes.txt' $public -Force
 
-          $publicZip = Join-Path $release 'SleepySource_1.0.0_Public.zip'
-          Compress-Archive -Path (Join-Path $public '*') -DestinationPath $publicZip -CompressionLevel Optimal
+          $publicZip = Join-Path $release 'SleepySource_1.0.0.zip'
+          Compress-Archive -Path $public -DestinationPath $publicZip -CompressionLevel Optimal
 
           $exclude = @('.git', 'smoke-dist', 'release-dist')
           Get-ChildItem -Force | Where-Object { $exclude -notcontains $_.Name } | ForEach-Object {
@@ -89,9 +89,9 @@ jobs:
           $pubArchive = [IO.Compression.ZipFile]::OpenRead($publicZip)
           try {
             $pubNames = @($pubArchive.Entries | ForEach-Object FullName)
-            if ($pubNames -notcontains 'SleepySource.exe') { throw 'Public ZIP is missing SleepySource.exe.' }
-            if ($pubNames -notcontains 'readme.txt') { throw 'Public ZIP is missing readme.txt.' }
-            if ($pubNames -notcontains 'release_notes.txt') { throw 'Public ZIP is missing release_notes.txt.' }
+            if ($pubNames -notcontains 'SleepySource 1.0.0/SleepySource.exe') { throw 'Release ZIP is missing SleepySource.exe.' }
+            if ($pubNames -notcontains 'SleepySource 1.0.0/readme.txt') { throw 'Release ZIP is missing readme.txt.' }
+            if ($pubNames -notcontains 'SleepySource 1.0.0/release_notes.txt') { throw 'Release ZIP is missing release_notes.txt.' }
             if ($pubNames | Where-Object { $_ -match '(^|/)SleepySource_Data/' }) { throw 'Public ZIP contains generated SleepySource_Data.' }
             if ($pubNames | Where-Object { $_ -match '\.xml$' }) { throw 'Public ZIP contains XML documentation files.' }
           }
@@ -114,7 +114,7 @@ jobs:
         with:
           name: SleepySource-1.0.0-Release-Packages
           path: |
-            release-dist/SleepySource_1.0.0_Public.zip
+            release-dist/SleepySource_1.0.0.zip
             release-dist/SleepySource_1.0.0_Source.zip
           if-no-files-found: error
 
@@ -125,7 +125,7 @@ jobs:
         run: |
           $ErrorActionPreference = 'Stop'
           & gh release create 'v1.0.0' `
-            'release-dist/SleepySource_1.0.0_Public.zip' `
+            'release-dist/SleepySource_1.0.0.zip' `
             'release-dist/SleepySource_1.0.0_Source.zip' `
             --repo $env:GITHUB_REPOSITORY `
             --target $env:GITHUB_SHA `
